# Copy to .env and fill in what you have. Everything is optional —
# the platform runs fully free without any of these.

# Secret used to sign login tokens. Set a long random string in production.
JWT_SECRET=

# Optional paid routing providers (checked in this order).
# When set, route ETAs use live traffic instead of the built-in rush-hour model.
MAPBOX_TOKEN=
TOMTOM_KEY=

# API server port (default 4000)
API_PORT=
