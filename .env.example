# Copy to .env and fill in what you have. The platform runs fully free
# without any of the optional keys below.

# REQUIRED IN PRODUCTION. Signs login tokens — if this is unset the server
# refuses to start with NODE_ENV=production (the dev fallback is public, so
# anyone reading this repo could otherwise forge a token for any account).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional paid routing providers (checked in this order).
# When set, route ETAs use live traffic instead of the built-in rush-hour model.
MAPBOX_TOKEN=
TOMTOM_KEY=

# Optional walking router, for the "Routed" walk mode on a stop.
# OpenRouteService has a free tier; Mapbox's token above also works.
ORS_TOKEN=

# API server port (default 4000)
API_PORT=

# Browser origins allowed to call this API, comma-separated. The native app's
# own origins are always allowed; localhost dev ports are allowed outside
# production. Set this to your deployed web origin(s).
#   CORS_ORIGINS=https://dispatch.example.com
CORS_ORIGINS=

# Set to 1 when running behind a load balancer / reverse proxy, so client IPs
# (used by sign-in throttling) are read from X-Forwarded-For.
TRUST_PROXY=

# Days of driver GPS breadcrumbs to keep (default 30). Set 0 to keep forever.
POSITION_RETENTION_DAYS=
