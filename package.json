{
  "name": "dispatch-route-builder",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm --prefix server run dev\" \"npm --prefix web run dev\"",
    "build": "npm --prefix web run build",
    "start": "NODE_ENV=production node server/src/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
